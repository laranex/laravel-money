{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laranex/laravel-money",
    "description": "Money for Laravel: exact, currency-aware amounts with arithmetic, percentages, allocation, formatting and Eloquent casts.",
    "keywords": [
        "laravel",
        "laranex",
        "laravel-money",
        "money",
        "moneyphp",
        "currency",
        "eloquent",
        "cast",
        "decimal",
        "percentage"
    ],
    "homepage": "https://laranex.vercel.app/laravel-money",
    "license": "MIT",
    "authors": [
        {
            "name": "Nay Thu Khant",
            "email": "naythukhant644@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-bcmath": "*",
        "illuminate/container": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/database": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/support": "^10.0||^11.0||^12.0||^13.0",
        "moneyphp/money": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.11||^3.9",
        "laravel/pint": "^1.20||^1.29",
        "orchestra/testbench": "^8.0||^9.0||^10.0||^11.0",
        "pestphp/pest": "^2.36||^3.0||^4.6",
        "pestphp/pest-plugin-type-coverage": "^2.8.7||^3.6.1||^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^1.12.17||^2.1.33"
    },
    "suggest": {
        "ext-intl": "Locale-aware formatting such as \"$1,234.50\" (without it, money formats as \"USD 1234.50\")"
    },
    "autoload": {
        "psr-4": {
            "Laranex\\LaravelMoney\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Laranex\\LaravelMoney\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint"
        ],
        "lint:check": [
            "vendor/bin/pint --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test:types": [
            "@php -d memory_limit=-1 vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laranex\\LaravelMoney\\LaravelMoneyServiceProvider"
            ],
            "aliases": {
                "LaravelMoney": "Laranex\\LaravelMoney\\Facades\\LaravelMoney"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore": {
                    "laravel/framework": "Dev-only: installed by Testbench for the test lanes; every Laravel 10 and most 11 releases carry advisories, and this package never requires laravel/framework"
                },
                "ignore-id": {
                    "PKSA-z3gr-8qht-p93v": "Dev-only PHPUnit advisory; needed for the PHP 8.1 test lane"
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
